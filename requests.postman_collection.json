            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/survey-answers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participationId\": {{participationId}},\n  \"questionId\": {{questionId}},\n  \"selectedValue\": \"Да\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"answerId\", pm.response.json().id);"
            ]
          }
        }
      ]
