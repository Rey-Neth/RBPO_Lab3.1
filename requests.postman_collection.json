              "pm.test(\"Участие начато заново\", function () { const p=pm.response.json(); pm.expect(p.status).to.eql(\"IN_PROGRESS\"); pm.expect(p.submittedAt).to.eql(null); });"
            ]
          }
        }
      ]
    },
