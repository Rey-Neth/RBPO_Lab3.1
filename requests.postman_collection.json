              "pm.test(\"Создан новый черновик без прежних сроков\", function () { const s=pm.response.json(); pm.expect(s.status).to.eql(\"DRAFT\"); pm.expect(s.startDate).to.eql(null); pm.expect(s.endDate).to.eql(null); });"
            ]
